# Copie para .env e preencha. O .env nao vai para o versionamento.

# Opcao 1 - string de conexao unica (Neon, Supabase, Heroku...). Tem precedencia.
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Opcao 2 - Postgres local via docker-compose.yml. Usado se DATABASE_URL estiver vazia.
DB_HOST=localhost
DB_PORT=5666
DB_NAME=metar_db
DB_USER=metar_user
DB_PASS=troque-esta-senha
